# Example .env file for local git repository mode

# Required for remote operations (can be empty for local mode)
GITHUB_TOKEN=
GITHUB_OWNER=

# Optional - hosting related
GHS3_PORT=8080
GHS3_ADDRESS=0.0.0.0

# Committer's information
GIT_USERNAME=GHS3
GIT_EMAIL=bot@ghs3.com

# Local repository mode - set this to enable local-only operation
# When set, the server will use this existing git repository instead of
# cloning from GitHub. Remote operations (push/pull) will be disabled.
# GHS3_LOCAL_REPO_PATH=/path/to/your/local/git/repo
